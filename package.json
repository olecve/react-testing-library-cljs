{
  "name": "react-testing-library-cljs",
  "scripts": {
    "generate:screen": "cd scripts && bb ./generate_screen.clj",
    "generate:fire-event": "cd scripts && bb ./generate_fire_event.clj",
    "watch": "npx shadow-cljs watch app",
    "release": "npx shadow-cljs release app",
    "test": "npx shadow-cljs compile test && node out/test.js",
    "test:watch": "npx shadow-cljs watch test --config-merge \"{:autorun true}\"",
    "lint": "clj-kondo --lint src",
    "patrol": "[ -f cljs-patrol.jar ] || curl -sL https://github.com/olecve/cljs-patrol/releases/download/v0.0.17/cljs-patrol-0.0.17.jar -o cljs-patrol.jar; java -jar cljs-patrol.jar --only docstrings --fail-on all src/main",
    "fmt": "prettier --write \"**/*.{clj,cljs,cljc,edn}\"",
    "fmt:check": "prettier --check \"**/*.{clj,cljs,cljc,edn}\""
  },
  "devDependencies": {
    "global-jsdom": "^28.0.0",
    "prettier": "^3.8.4",
    "prettier-plugin-cljfmt": "^0.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadow-cljs": "3.4.11"
  },
  "dependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1"
  },
  "overrides": {
    "ws@8": "^8.21.0",
    "undici": "^7.28.0"
  }
}
