{
  "name": "my-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm run clean && shadow-cljs release app",
    "ci": "npm run fmt:check && npm run lint && shadow-cljs compile app && npm test && npm run test:karma",
    "clean": "rimraf public/js",
    "fmt:clj": "prettier --write \"**/*.{clj,cljs,cljc,edn}\"",
    "fmt:check": "prettier --check \"**/*.{clj,cljs,cljc,edn}\"",
    "fmt:sort-package-json": "sort-package-json package.json",
    "fmt": "run-s fmt:clj fmt:sort-package-json",
    "lint": "clj-kondo --lint src",
    "report": "shadow-cljs run shadow.cljs.build-report app report.html",
    "sc": "shadow-cljs",
    "server": "shadow-cljs stop && shadow-cljs start",
    "start": "shadow-cljs watch app",
    "test:karma": "shadow-cljs compile karma && karma start --single-run --reporters dots",
    "test:karma:compile": "shadow-cljs watch karma --config-merge \"{:autorun true}\"",
    "test:karma:run": "karma start --reporters junit,dots",
    "test:karma:watch": "concurrently --prefix none \"npm run test:karma:run\" \"npm run test:karma:compile\"",
    "test:watch": "shadow-cljs watch test --config-merge \"{:autorun true}\"",
    "test": "shadow-cljs compile test && node out/test.js"
  },
  "dependencies": {
    "karma": "6.4.2",
    "karma-chrome-launcher": "3.2.0",
    "karma-cli": "2.0.0",
    "karma-cljs-test": "0.1.0",
    "karma-junit-reporter": "2.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sort-package-json": "2.5.1"
  },
  "overrides": {
    "minimatch": "^3.1.3",
    "ws@7": "^7.5.11",
    "ws@8": "^8.21.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.2",
    "clj-kondo": "2025.10.23",
    "concurrently": "8.0.1",
    "global-jsdom": "^28.0.0",
    "npm-run-all": "4.1.5",
    "prettier": "^3.8.4",
    "prettier-plugin-cljfmt": "^0.1.1",
    "rimraf": "~3.0.2",
    "shadow-cljs": "3.4.11"
  }
}
